# ─────────────────────────────────────────────────────────────────────────────
# KrishiMitra frontend — environment variables (EXAMPLE / template)
#
# Copy this file to  frontend/.env.local  and fill in real values:
#     macOS / Linux:   cp .env.example .env.local
#     Windows (cmd):   copy .env.example .env.local
#
# frontend/.env.local is gitignored and must NEVER be committed.
# Vite only exposes variables prefixed with VITE_ to the browser bundle, so
# never put a secret here — everything in this file ships to the client.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API base URL ─────────────────────────────────────────────────────
# MUST include the trailing "/api" and NO trailing slash.
#
# Local development (Django dev server):
#     VITE_API_URL=http://localhost:5001/api
# Production (Render backend):
#     VITE_API_URL=https://<your-backend>.onrender.com/api
#
# If this is left unset, the app falls back to http://<current-host>:5001/api,
# which only works for local development and is insecure (plain http) in
# production. Always set this explicitly for any deployed build.
VITE_API_URL=http://localhost:5001/api

# ── Google OAuth client ID (public identifier, not a secret) ─────────────────
# From Google Cloud Console → Credentials → OAuth 2.0 Client IDs (Web).
# Must match GOOGLE_CLIENT_ID configured on the backend.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
