# ─────────────────────────────────────────────────────────────────────────────
# KrishiMitra backend — environment variables (EXAMPLE / template)
#
# Copy this file to  backend/.env  and fill in real values:
#     Windows (cmd):   copy .env.example .env
#     PowerShell:      Copy-Item .env.example .env
#     macOS / Linux:   cp .env.example .env
#
# backend/.env is strictly gitignored and must NEVER be committed.
# The server boots without .env using local defaults, but credential-dependent
# integrations (Gemini Vision, real SMTP emails, live Data.gov sync) require
# their respective API keys/credentials to be configured below.
# Do not put real secrets in this public example file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core / security ──────────────────────────────────────────────────────────
# Django secret key. An insecure dev fallback is used if this is unset; set a
# long random value for any shared or production environment.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# "1" = debug on (development), "0" = debug off (production).
DJANGO_DEBUG=1

# ── Database (PostgreSQL in production; SQLite fallback locally) ──────────────
# If DATABASE_URL is set, Django uses it via dj-database-url with SSL required
# (works for Neon, Supabase, or any managed Postgres). If unset, the backend
# falls back to a local SQLite file (backend/db.sqlite3) for development.
# Neon example (note the required sslmode):
#     DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# DATABASE_URL=

# ── Production hosts / origins (only needed when DJANGO_DEBUG=0) ──────────────
# Comma-separated. If unset in production, ALLOWED_HOSTS defaults to
# .onrender.com + localhost, and the Render hostname is auto-appended.
# ALLOWED_HOSTS=your-backend.onrender.com
# Comma-separated exact origins allowed to call the API from the browser.
# If unset, CORS is fully open (dev convenience) — set this in production.
# CORS_ALLOWED_ORIGINS=https://your-frontend.workers.dev,https://your-frontend.pages.dev
# Comma-separated origins trusted for CSRF (defaults to https://*.onrender.com).
# CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com
# HTTPS redirect is ON by default in production (safe behind Render's proxy).
# Set to "0" only to intentionally allow plain HTTP.
# SECURE_SSL_REDIRECT=1
# HTTP Strict Transport Security — OFF by default (hard to reverse; risky on a
# shared *.onrender.com host). Opt in once on a stable/custom HTTPS domain.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# SECURE_HSTS_PRELOAD=0

# ── Background scheduler (APScheduler) ───────────────────────────────────────
# "1" to enable the market-sync scheduler. Default "0": Render free instances
# spin down when idle, so the scheduler is off unless explicitly enabled.
# ENABLE_SCHEDULER=0

# ── Server port (used by local dev scripts; Render injects its own PORT) ─────
# PORT=5001

# ── AI: Google Gemini (live disease detection & AI recommendations) ──────────
# REST API key from Google AI Studio. If empty, Gemini-backed features return a
# graceful "unavailable" response instead of crashing.
GEMINI_API_KEY=
# Gemini model ID (default: gemini-flash-latest).
GEMINI_MODEL=gemini-3.1-flash-lite

# ── RAG / vector store (ChromaDB) ────────────────────────────────────────────
# Absolute path to the persistent Chroma store. LEAVE THIS COMMENTED OUT to use
# the default (backend/knowledge-base/chroma_db). Do not set it to an empty
# value — an empty string would override the default with "".
# Regenerate the collections with the scripts in backend/knowledge-base/scripts/.
# CHROMA_DB_PATH=C:\path\to\chroma_db

# ── Market data (data.gov.in mandi prices) ───────────────────────────────────
# API key from https://data.gov.in. Without it, the market-price sync is skipped.
DATAGOV_API_KEY=

# ── Email (password-reset OTP via SMTP) ──────────────────────────────────────
# Defaults target Gmail SMTP. Leave user/password empty to disable email sending.
# (Do not set EMAIL_PORT to an empty value — it is parsed with int().)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Email (optional Brevo transactional API, used over HTTPS instead of SMTP) ─
# If BREVO_API_KEY is set, OTP emails are sent via Brevo's REST API (port 443),
# which is more reliable on hosts that block outbound SMTP. Falls back to SMTP
# above when empty.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=KrishiMitra

# ── Google OAuth (Sign in with Google) ───────────────────────────────────────
# Web client ID from Google Cloud Console. Must match the frontend's
# VITE_GOOGLE_CLIENT_ID. Leave empty to disable Google sign-in verification.
GOOGLE_CLIENT_ID=

# ── Advanced / rarely needed ─────────────────────────────────────────────────
# Set to "1" to skip importing TensorFlow (only relevant if TF is installed).
DISABLE_TENSORFLOW_IMPORT=0
